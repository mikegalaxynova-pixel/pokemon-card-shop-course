[{% for d in site.research %}{"t":{{ d.title | jsonify }},"u":{{ d.url | relative_url | jsonify }},"k":"调研","c":{{ d.content | strip_html | strip_newlines | truncate: 3000 | jsonify }}},{% endfor %}{% for d in site.kb %}{"t":{{ d.title | jsonify }},"u":{{ d.url | relative_url | jsonify }},"k":"基础知识","c":{{ d.content | strip_html | strip_newlines | truncate: 3000 | jsonify }}},{% endfor %}{% for s in site.shops %}{"t":{{ s.title | jsonify }},"u":{{ s.url | relative_url | jsonify }},"k":"店铺案例","c":{{ s.content | strip_html | strip_newlines | truncate: 3000 | jsonify }}},{% endfor %}{% for v in site.videos %}{"t":{{ v.title_zh | default: v.title | jsonify }},"u":{{ v.url | relative_url | jsonify }},"k":"视频","c":{{ v.description | append: " " | append: v.title | append: " " | append: v.creator | append: " " | append: v.content | strip_html | strip_newlines | truncate: 2000 | jsonify }}},{% endfor %}{% for p in site.posts %}{% capture nt %}{% for n in p.news %}{{ n.title }} {{ n.summary }} {% endfor %}{% endcapture %}{"t":{{ p.title | jsonify }},"u":{{ p.url | relative_url | jsonify }},"k":"新闻","c":{{ p.content | strip_html | strip_newlines | append: " " | append: nt | jsonify }}},{% endfor %}{% assign g = site.pages | where: "url", "/glossary/" | first %}{"t":"术语表","u":{{ '/glossary/' | relative_url | jsonify }},"k":"工具","c":{{ g.content | strip_html | strip_newlines | jsonify }}}{% for r in site.data.recommendations %}{% unless r.type == "video" or r.type == "podcast" %},{"t":{{ r.title | jsonify }},"u":{{ r.url | jsonify }},"k":"工具","c":{{ r.note | append: " " | append: r.creator | jsonify }}}{% endunless %}{% endfor %}]
